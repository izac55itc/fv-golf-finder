# ── Mapbox (traffic-aware drive times) ───────────────────────────────────────
# Free tier: 100,000 requests/month, no credit card required
# Get a token: https://account.mapbox.com/
# Restrict it to your GitHub Pages domain in Mapbox account settings
# Add as a GitHub Actions secret named VITE_MAPBOX_TOKEN for production builds
VITE_MAPBOX_TOKEN=

# ── Optional: override the tee time data URL for local dev ───────────────────
# Defaults to the live data branch on GitHub — only set this if testing locally
# VITE_DATA_URL=http://localhost:3001/teetimes.json
